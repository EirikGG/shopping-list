<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Levels come from the environment (.env through docker-compose.yml):
         trace, debug, info, warn, error or off. LOG_LEVEL is the app's own
         code; LOG_LEVEL_ROOT is everything else, such as Jetty and Liquibase. -->
    <logger name="no.eirikgg.shoppinglist" level="${LOG_LEVEL:-debug}"/>

    <root level="${LOG_LEVEL_ROOT:-info}">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
