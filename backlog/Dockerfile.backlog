FROM node:22-bookworm-slim

ARG BACKLOG_VERSION=latest
RUN apt-get update \
    && apt-get install -y --no-install-recommends git socat ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "backlog.md@${BACKLOG_VERSION}" \
    && npm cache clean --force

WORKDIR /repo

EXPOSE 16420

CMD ["sh", "-ec", "socat TCP-LISTEN:16420,bind=0.0.0.0,reuseaddr,fork TCP:127.0.0.1:6420 & exec backlog browser --no-open --port 6420"]
