# Prod and test: the domain the site is served on. Caddy gets an HTTPS
# certificate for it on its own; DNS must point here and ports 80 and 443
# must be open. "localhost" gives a self-signed certificate for trying it out.
SITE_ADDRESS=localhost

# Dev only: the port of the Vite dev server.
WEB_PORT=80
# Only for the Vite dev server (dev profile): domain names it answers to,
# comma-separated. Empty allows only localhost and IP addresses.
ALLOWED_HOSTS=

APP_PORT=8080

# Backend logging: trace, debug, info, warn, error or off. LOG_LEVEL is the
# app's own code, LOG_LEVEL_ROOT the libraries. debug also logs every SQL
# query and the email check every 10 seconds; info is usually enough in prod.
LOG_LEVEL=debug
LOG_LEVEL_ROOT=info

DB_NAME=testdb
DB_USERNAME=testuser
DB_PASSWORD=replace-with-a-password
DB_PORT=5432
DB_POOL_SIZE=15

# SMTP server for outgoing email. Dev and test use Mailpit, which needs no login.
MAIL_HOST=mailpit
MAIL_PORT=1025
# Leave both empty for Mailpit. With them set, the login always goes over TLS.
# Resend in prod: MAIL_HOST=smtp.resend.com, MAIL_PORT=465,
# MAIL_USERNAME=resend and MAIL_API_KEY=<your Resend API key>.
# Many hosting providers block outgoing 465; Resend's port 2587 (STARTTLS)
# then usually works instead.
MAIL_USERNAME=
MAIL_API_KEY=
# With Resend this must be on a domain verified there.
MAIL_FROM=Shopping list <noreply@eirikgg.no>
MAILPIT_UI_PORT=8025
