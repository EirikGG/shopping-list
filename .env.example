# Local development (docker compose --profile dev).

# The port of the Vite dev server.
WEB_PORT=80
# Domain names the Vite dev server answers to, comma-separated. Empty allows
# only localhost and IP addresses.
ALLOWED_HOSTS=

# The Home Assistant user the dev server pretends to be. Change the id to see
# the app as another user.
DEV_HA_USER_ID=dev-user
DEV_HA_USER_NAME=Dev User

APP_PORT=8080

# Backend logging: trace, debug, info, warn, error or off. LOG_LEVEL is the
# app's own code, LOG_LEVEL_ROOT the libraries. debug also logs every SQL query.
LOG_LEVEL=debug
LOG_LEVEL_ROOT=info
